DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=saas

JWT_ACCESS_SECRET=password
JWT_REFRESH_SECRET=password
JWT_RESET_PASSWORD_SECRET=password
